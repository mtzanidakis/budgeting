# tsrp (production)
HOSTNAME=budgeting
TS_AUTHKEY=XXXX

# Server Configuration
PORT=4666

# Database
DATABASE_PATH=./data/budgeting.db

# Security
# Generate a secure random secret with: openssl rand -base64 32
SESSION_SECRET=change-me-in-production

# Logging
LOG_LEVEL=info

# Display
CURRENCY=€

# AI chat sidebar (optional) — any OpenAI-compatible chat completions API.
# The model must support tool calling; image input is needed for receipt photos.
AI_CHAT_ENABLED=false
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
